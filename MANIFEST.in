include README.rst
include LICENSE
include DATA_VERSION
include pyproject.toml
include setup.py
recursive-include timezonefinder *.py *.fbs *.c *.h
# the second distribution in this workspace, built and released on its own
prune packages
recursive-exclude prototypes *
exclude AGENTS.md
exclude CONTRIBUTING.md
exclude CLAUDE.md
recursive-exclude .cursor *
recursive-exclude .claude *
recursive-exclude .agents *
recursive-exclude contributing *
graft tests
prune tests/.pytest_cache
prune .git
global-exclude __pycache__/*
global-exclude *.pyc
