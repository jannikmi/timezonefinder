include README.rst
include LICENSE
include DATA_LICENSE
include DATA_VERSION
include pyproject.toml
include setup.py
recursive-include timezonefinder *.py *.npy *.fbs *.txt *.json *.c *.h
recursive-exclude prototypes *
exclude AGENTS.md
exclude CONTRIBUTING.md
exclude CLAUDE.md
exclude potential-improvements.md
recursive-exclude .cursor *
recursive-exclude .claude *
graft tests
prune tests/.pytest_cache
prune .git
global-exclude __pycache__/*
global-exclude *.pyc
