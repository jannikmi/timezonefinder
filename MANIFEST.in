include README.rst
include LICENSE
include DATA_VERSION
include DATA_SOURCE
include pyproject.toml
include setup.py
recursive-include timezonefinder *.py *.fbs *.c *.h
# cffi regenerates this wrapper from inside_poly_extension/ during the wheel build, so
# the sdist neither needs nor should carry it. Without the exclusion it is shipped
# whenever the extension happens to have been compiled in place, and check-manifest
# then fails because the file is (correctly) not in version control.
exclude timezonefinder/inside_polygon_ext.c
# the second distribution in this workspace, built and released on its own
prune packages
recursive-exclude prototypes *
exclude AGENTS.md
exclude CONTRIBUTING.md
exclude CLAUDE.md
recursive-exclude .cursor *
recursive-exclude .claude *
recursive-exclude .agents *
recursive-exclude contributing *
# unreleased changelog fragments; the release folds them into CHANGELOG.rst and
# deletes them, so nothing here is ever part of a published distribution
prune changelog.d
graft tests
prune tests/.pytest_cache
prune .git
global-exclude __pycache__/*
global-exclude *.pyc
