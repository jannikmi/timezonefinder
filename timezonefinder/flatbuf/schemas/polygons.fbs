namespace timezonefinder.flatbuf.generated.polygons;

table Polygon {
  // the ring's bit-packed residuals, as 32-bit words; see
  // timezonefinder/block_payload.py for what one block holds
  payload:[uint];
}

table PolygonCollection {
  polygons:[Polygon];
  // encoding of the `payload` vectors; see POLYGON_LAYOUT_VERSION in
  // timezonefinder/flatbuf/io/polygons.py. absent (= 0) in files written
  // before the per-axis layout was introduced.
  layout_version:ushort;
}

root_type PolygonCollection;
file_identifier "TZFP";
